# ============================================================
# Supabase Authentication
# ============================================================

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_ALGORITHM=ES256


# ============================================================
# Database
# ============================================================

DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_SUPABASE_POOLER_HOST:5432/postgres

# Migration CLI only. Alembic deliberately ignores DATABASE_URL so migrations
# require an explicit target.
ALEMBIC_DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_SUPABASE_POOLER_HOST:5432/postgres


# ============================================================
# AI Service
# ============================================================

AI_SERVICE_URL=http://127.0.0.1:8001


# ============================================================
# OpenRouter / Recipe Generation
# ============================================================

OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free


# ============================================================
# Google Cloud Vision
# ============================================================

GOOGLE_APPLICATION_CREDENTIALS=credentials/google-vision.json


# ============================================================
# Development / Sample Scanning
# ============================================================

ENABLE_SAMPLE_SCAN=false


# ============================================================
# Push Notifications
# ============================================================

# Long random server-only secret used by the scheduler when
# calling POST /api/v1/notifications/jobs/expiry
NOTIFICATION_JOB_SECRET=replace-with-a-long-random-secret

# Optional. Leave blank unless Expo push access-token security
# is enabled for the EAS project.
EXPO_PUSH_ACCESS_TOKEN=

EXPO_PUSH_TIMEOUT_SECONDS=10


# ============================================================
# Rate limiting (invite join + scans)
# ============================================================

# Per authenticated user, in this backend process only.
# Cloudflare tunnels share one TCP peer, so limits use the JWT subject.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_JOIN_ATTEMPTS=10
RATE_LIMIT_JOIN_WINDOW_SECONDS=60
RATE_LIMIT_SCAN_ATTEMPTS=20
RATE_LIMIT_SCAN_WINDOW_SECONDS=60