# Backend configuration; never commit real credentials.
DATABASE_URL=postgresql://postgres.nkrxfkwudbvqblvneium:CapstoneYear3!!@aws-1-us-east-1.pooler.supabase.com:5432/postgres
AI_SERVICE_URL=http://127.0.0.1:8001
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Must match the project's configured signing algorithm, not a token header.
SUPABASE_JWT_ALGORITHM=HS256
# HS256 only: the legacy JWT signing secret, NOT an anon key or service role key.
SUPABASE_JWT_SECRET=replace-with-your-jwt-signing-secret
# For ES256 / RS256 omit the secret; verification uses the project's public JWKS.
ENABLE_SAMPLE_SCAN=false
SAMPLE_IMAGES_DIR=samples
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openrouter/free
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-vision.json
