# Backend configuration; never commit real credentials.
# ---
# Mealventory Backend Environment Configuration

# Supabase Authentication & Project
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_ALGORITHM=
SUPABASE_JWT_SECRET=replace-with-your-jwt-signing-secret

# Database Connection (SQLite local test database)
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# AI Microservice Gateway
AI_SERVICE_URL=http://127.0.0.1:8001
ENABLE_SAMPLE_SCAN=false
SAMPLE_IMAGES_DIR=samples

# OpenRouter / LLM Settings
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openrouter/free

# Legacy Setting (to be removed with BE-03)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-vision.json`

# ---

# Must match the project's configured signing algorithm, not a token header.
# HS256 only: the legacy JWT signing secret, NOT an anon key or service role key.
# For ES256 / RS256 omit the secret; verification uses the project's public JWKS.

# Development only. For production, set exact browser frontend origins.
# Example: CORS_ORIGINS=http://localhost:8082,https://app.example.com
# If the WEB FRONTEND uses a tunnel, add its exact https://NAME.trycloudflare.com origin.
# A backend-only tunnel is the API destination, not the browser frontend origin.
# No paths, exp:// URLs, or *.trycloudflare.com patterns. Restart after changing.
