  "info": {
    "title": "Mealventory API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "health_check__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
    "/api/v1/food/predict-expiry/{food_id}": {
      "post": {
        "description": "Predict and update the expiry date for a food item based on purchase date\nand environmental conditions (temperature and humidity).",
        "operationId": "predict_food_expiry_api_v1_food_predict_expiry__food_id__post",
        "parameters": [
          {
            "in": "path",
            "name": "food_id",
            "required": true,
            "schema": {
              "title": "Food Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "purchase_date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Purchase Date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "temperature",
            "required": true,
            "schema": {
              "title": "Temperature",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "humidity",
            "required": true,
            "schema": {
              "title": "Humidity",
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Predict Food Expiry",
        "tags": [
          "Food"
        ]
      }
    },
    "/api/v1/inventory/": {
      "get": {
        "description": "Return all inventory items belonging to the current user.",
        "operationId": "list_inventory_api_v1_inventory__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InventoryItemOut"
                  },
                  "title": "Response List Inventory Api V1 Inventory  Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Inventory",
        "tags": [
          "Inventory"
        ]
      },
      "post": {
        "description": "Manually add a food item to the current user's inventory.",
        "operationId": "add_inventory_item_api_v1_inventory__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InventoryItemCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryItemOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Add Inventory Item",
        "tags": [
          "Inventory"
        ]
      }
    },
    "/api/v1/inventory/{item_id}": {
      "delete": {
        "description": "Remove an item from the current user's inventory.",
        "operationId": "delete_inventory_item_api_v1_inventory__item_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "title": "Item Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Inventory Item",
        "tags": [
          "Inventory"
        ]
      }
    },
    "/api/v1/recipes/": {
      "get": {
        "description": "Return recipe suggestions from the ai-service based on the user's\ncurrent inventory.",
        "operationId": "get_recipes_api_v1_recipes__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Recipes",
        "tags": [
          "Recipes"
        ]
      }
    },
    "/api/v1/scan/": {
      "post": {
        "description": "Upload an image with a selected mode (food, receipt, tag).\nThe ai-service detects food items and they are automatically added\nto the user's inventory.",
        "operationId": "scan_and_add_api_v1_scan__post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_scan_and_add_api_v1_scan__post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InventoryItemOut"
                  },
                  "title": "Response Scan And Add Api V1 Scan  Post",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Image type mismatch or no food items detected"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Scan And Add",
        "tags": [
          "Scan"
        ]
      }
    },
    "/api/v1/scan/sample": {
      "post": {
        "description": "Dev helper: read a .jpg/.jpeg from backend/samples and process it like an uploaded image.",
        "operationId": "scan_from_sample_api_v1_scan_sample_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SampleScanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid request data"
          },
          "403": {
            "description": "Sample scan route disabled"
          },
          "404": {
            "description": "Sample image or user not found"
          },
          "422": {
            "description": "Image mismatch or no food detected"
          }
        },
        "summary": "Scan From Sample",
        "tags": [
          "Scan"
        ]
      }
    },
    "/api/v1/users/me": {
      "get": {
        "description": "Return the profile of the currently authenticated user.",
        "operationId": "get_me_api_v1_users_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Me",
        "tags": [
          "Users"
        ]
      }
    },
    "/api/v1/users/register": {
      "post": {
        "description": "Sync a Firebase-authenticated user into the database.",
        "operationId": "register_user_api_v1_users_register_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Register User",
        "tags": [
          "Users"
        ]
      }
    }
  }
}
